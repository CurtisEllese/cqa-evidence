# Server-only signed URL from organizer materials.
ORGANIZER_DEV_URL=
DATABASE_PATH=./local-data/cqa.sqlite
# Optional expert-approved KnowledgeFact JSON array. Server-only; restart after changes.
# Leave empty until product, jurisdiction and effective dates are confirmed.
KNOWLEDGE_FACTS_PATH=
# Vite only: local backend destination, never a secret.
BACKEND_URL=http://127.0.0.1:8000
# In-process adapter; select provider explicitly and keep keys server-side.
EVALUATOR_ADAPTER=evaluator.provider:evaluate
# Provider settings read only by your adapter; no customer calls without configuration.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
OPENAI_BUDGET_USD=0.50
# Conservative input bound includes possible cache writes; not a billing invoice.
OPENAI_INPUT_USD_PER_MILLION=0.125
OPENAI_OUTPUT_USD_PER_MILLION=0.50
