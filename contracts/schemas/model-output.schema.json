{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "message",
            "absence",
            "not_applicable"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Message Ids",
          "type": "array"
        },
        "start_message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Message Id"
        },
        "end_message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Message Id"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        }
      },
      "required": [
        "kind",
        "message_ids",
        "start_message_id",
        "end_message_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ModelDecision": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "na_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Na Reason"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "criterion_id",
        "value",
        "explanation",
        "na_reason",
        "evidence"
      ],
      "title": "ModelDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/ModelDecision"
      },
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "results"
  ],
  "title": "ModelOutput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
