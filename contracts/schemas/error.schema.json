{
  "$defs": {
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "INVALID_CHECKLIST",
            "MODEL_OUTPUT_INVALID",
            "PROVIDER_RATE_LIMIT",
            "PROVIDER_UNAVAILABLE",
            "MODEL_REFUSAL",
            "NOT_FOUND",
            "REVISION_CONFLICT",
            "INTERNAL_ERROR"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retry After Seconds"
        },
        "details": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Details",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "retry_after_seconds",
        "details"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "criterion_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Criterion Id"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "criterion_id",
        "path",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/ErrorBody"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "error"
  ],
  "title": "ErrorResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
