{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cqa:contracts:2.0:StartEvaluationRequest",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "conversationId": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Conversationid",
      "type": "string"
    },
    "checklistVersion": {
      "anyOf": [
        {
          "maximum": 1000000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checklistversion"
    }
  },
  "required": [
    "schema_version",
    "conversationId"
  ],
  "title": "StartEvaluationRequest",
  "type": "object"
}
