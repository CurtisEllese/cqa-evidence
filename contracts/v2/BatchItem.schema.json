{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cqa:contracts:2.0:BatchItem",
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "evaluationId": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Evaluationid",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "needs_review",
        "failed",
        "uncertain",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "id",
    "evaluationId",
    "status"
  ],
  "title": "BatchItem",
  "type": "object"
}
