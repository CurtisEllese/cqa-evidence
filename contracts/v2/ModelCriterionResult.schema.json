{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cqa:contracts:2.0:ModelCriterionResult",
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "message",
          "enum": [
            "message",
            "absence",
            "not_applicable"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Id"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "start_message_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Message Id"
        },
        "end_message_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Message Id"
        }
      },
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "criterionId": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Criterionid",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    },
    "explanation": {
      "maxLength": 20000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Explanation",
      "type": "string"
    },
    "applicability_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Applicability Reason"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "criterionId",
    "value",
    "explanation",
    "applicability_reason",
    "evidence"
  ],
  "title": "ModelCriterionResult",
  "type": "object"
}
