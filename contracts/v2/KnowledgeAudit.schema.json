{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cqa:contracts:2.0:KnowledgeAudit",
  "$defs": {
    "KnowledgeScope": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Entity",
          "type": "string"
        },
        "jurisdiction": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Jurisdiction",
          "type": "string"
        },
        "product": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Product",
          "type": "string"
        },
        "conversation_date": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Conversation Date",
          "type": "string"
        },
        "date_source": {
          "const": "conversation",
          "title": "Date Source",
          "type": "string"
        },
        "verified_by": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Verified By",
          "type": "string"
        },
        "verification_reference": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Verification Reference",
          "type": "string"
        }
      },
      "required": [
        "entity",
        "jurisdiction",
        "product",
        "conversation_date",
        "date_source",
        "verified_by",
        "verification_reference"
      ],
      "title": "KnowledgeScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "policy_version": {
      "const": "scoped-knowledge-1",
      "default": "scoped-knowledge-1",
      "title": "Policy Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "excluded",
        "not_configured",
        "scoped_verified"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "included_fact_ids": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Included Fact Ids",
      "type": "array"
    },
    "excluded_fact_count": {
      "default": 0,
      "minimum": 0,
      "title": "Excluded Fact Count",
      "type": "integer"
    }
  },
  "required": [
    "status",
    "reason"
  ],
  "title": "KnowledgeAudit",
  "type": "object"
}
