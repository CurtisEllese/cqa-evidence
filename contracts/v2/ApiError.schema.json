{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cqa:contracts:2.0:ApiError",
  "$defs": {
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "code": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Code",
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Message",
      "type": "string"
    },
    "details": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "title": "Details",
      "type": "array"
    },
    "request_id": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Request Id",
      "type": "string"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "code",
    "message",
    "request_id",
    "retryable"
  ],
  "title": "ApiError",
  "type": "object"
}
