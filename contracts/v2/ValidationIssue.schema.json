{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cqa:contracts:2.0:ValidationIssue",
  "additionalProperties": false,
  "properties": {
    "code": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Code",
      "type": "string"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "code",
    "path",
    "message"
  ],
  "title": "ValidationIssue",
  "type": "object"
}
